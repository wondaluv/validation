# AfriPay Configuration
# Copy this file to .env and fill in your values

# Environment: sandbox or production
AFRIPAY_ENV=sandbox
AFRIPAY_API_VERSION=v1
AFRIPAY_BASE_URL=https://api.afripay.io

# Security
AFRIPAY_WEBHOOK_SECRET=whsec_your_webhook_secret_here
AFRIPAY_ENCRYPTION_KEY=your_32_char_encryption_key_here
AFRIPAY_JWT_SECRET=your_jwt_secret_key_here
AFRIPAY_JWT_EXPIRES=24h

# Server
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===========================================
# M-Pesa Configuration (Kenya, Tanzania)
# ===========================================
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_CALLBACK_URL=https://yourdomain.com/webhooks/mpesa

# ===========================================
# MTN MoMo Configuration (Ghana, Uganda, etc.)
# ===========================================
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_API_KEY=your_mtn_api_key
MTN_USER_ID=your_mtn_user_id
MTN_ENVIRONMENT=sandbox
MTN_CALLBACK_URL=https://yourdomain.com/webhooks/mtn-momo

# ===========================================
# Airtel Money Configuration
# ===========================================
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_CALLBACK_URL=https://yourdomain.com/webhooks/airtel

# ===========================================
# Card Processor Configuration
# Choose one: paystack, flutterwave, or interswitch
# ===========================================
CARD_PROCESSOR=paystack

# Paystack
CARD_PROCESSOR_PUBLIC_KEY=pk_test_your_paystack_public_key
CARD_PROCESSOR_SECRET=sk_test_your_paystack_secret_key

# Flutterwave (uncomment if using)
# CARD_PROCESSOR=flutterwave
# CARD_PROCESSOR_PUBLIC_KEY=FLWPUBK_TEST-xxx
# CARD_PROCESSOR_SECRET=FLWSECK_TEST-xxx
# CARD_PROCESSOR_ENCRYPTION_KEY=xxx

# Interswitch (uncomment if using)
# CARD_PROCESSOR=interswitch
# CARD_PROCESSOR_PUBLIC_KEY=your_merchant_code
# CARD_PROCESSOR_SECRET=your_interswitch_secret

# ===========================================
# Database Configuration (for production)
# ===========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/afripay
# REDIS_URL=redis://localhost:6379

# ===========================================
# Monitoring & Logging
# ===========================================
LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn
